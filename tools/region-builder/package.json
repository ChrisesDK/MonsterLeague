{
  "name": "@oml/region-builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@mapbox/vector-tile": "^2.0.3",
    "@oml/data": "workspace:*",
    "@turf/turf": "^7.1.0",
    "h3-js": "^4.1.0",
    "osmtogeojson": "^3.0.0-beta.5",
    "pbf": "^4.0.1",
    "pmtiles": "^3.2.1",
    "rbush": "^4.0.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/rbush": "^4.0.0"
  },
  "scripts": {
    "region": "tsx src/build.ts",
    "fetch": "tsx src/fetch-cli.ts",
    "basemap": "tsx src/basemap-extract.ts",
    "routes": "tsx src/routes.ts && prettier --write ../../packages/data/content/odense/routes.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
