{
  "name": "odense-monster-league",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "e2e": "pnpm --filter @oml/client e2e",
    "test": "pnpm -r --if-present test",
    "coverage": "pnpm --filter @oml/engine coverage",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "validate": "tsx packages/data/src/validate.ts",
    "sim": "tsx tools/sim/src/cli.ts",
    "dev": "pnpm --filter @oml/client dev",
    "sim:report": "tsx tools/sim/src/report-cli.ts",
    "gate2:report": "tsx tools/gate2/src/cli.ts",
    "gate3:report": "tsx tools/gate3/src/cli.ts",
    "region:build": "pnpm --filter @oml/region-builder region",
    "routes:build": "pnpm --filter @oml/region-builder routes",
    "spawn:report": "pnpm --filter @oml/spawn report",
    "art:build": "pnpm --filter @oml/art build",
    "docs:content": "pnpm --filter @oml/docs build",
    "regions:status": "tsx tools/docs/src/regions-status.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^20.17.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.5"
  },
  "license": "UNLICENSED"
}
